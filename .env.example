# Clave gratuita de https://aistudio.google.com. Sin ella el servicio arranca,
# pero las funciones con lenguaje natural responden 503 y el backend usa reglas.
GEMINI_API_KEY=

# Secreto compartido con el backend (misma variable allí). Sin él, /v1 no
# atiende a nadie. Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
HUECKO_IA_TOKEN=
